import os
from os.path import join
from pathlib import Path
import sys

sys.path.append(".")
from pkg.io import files_match_pattern

"""
This is a full pre-processing workflow for MSI data (provided as .imzML or .d).

input:
    data folder must contain the following directories:
    - "msi": directory with .imzML files or .d directories named group_sampleno.imzML/.d

output:
    sub-directories will be created for each pre-processing step containing the processed data
    along with quality control visualizations.
"""


configfile: 'data/config.yaml'


msi_pattern = r"^[a-zA-z0-9]+_[a-zA-z0-9]+\.(imzML|d)$" # imzML files must be named: condition_sampleno.imzML


SCRIPT_PATH = os.path.join('msi_preprocessing_flow', 'scripts')
SEGMENTATION_SCRIPT_PATH = os.path.join(SCRIPT_PATH, '../..', 'msi_segmentation_flow/scripts')
ANALYSIS_SCRIPT_PATH = os.path.join(SCRIPT_PATH, '../..', 'region_group_analysis_flow/scripts')
VIS_SCRIPT_PATH = os.path.join(SCRIPT_PATH, '../..', 'data_visualization')
DATA_PATH = config['data']

BENCHMARK_PATH = join(DATA_PATH, 'benchmark')
#BM_REPEAT = 1
INPUT_DIR = join(DATA_PATH, 'msi')
OUT_DIR = join(DATA_PATH, 'msi')
FILES = files_match_pattern(INPUT_DIR, msi_pattern)
FILES = [f.split('.')[0] for f in FILES]
EXT = [f.split('.')[1] for f in os.listdir(INPUT_DIR) if f.endswith('.d') or f.endswith('.imzML')][0]
#print('found {} files. \n processing files: {}'.format(len(FILES), FILES))
SDF_FILES = list(Path(DATA_PATH).glob("*.sdf"))
if len(SDF_FILES) == 1:
    SDF_FILE = str(SDF_FILES[0])
else:
    SDF_FILE = None
MASS_LIST = []
MASS_LIST_STR = ''
if config['general']['mass_list'] != '':
    MASS_LIST_STR += config['general']['mass_list']
    MASS_LIST.extend([float(item) for item in config['general']['mass_list'].split(',')])
QC_MASS_LIST = MASS_LIST.copy()
QC_MASS_LIST_STR = MASS_LIST_STR
if config['general']['qc_mass_list'] != '':
    if QC_MASS_LIST_STR != '':
        QC_MASS_LIST_STR = QC_MASS_LIST_STR + ',' + config['general']['qc_mass_list']
    else:
        QC_MASS_LIST_STR += config['general']['qc_mass_list']
    QC_MASS_LIST.extend([float(item) for item in config['general']['qc_mass_list'].split(',')])
if config['calibration']:
    MAX_VAL_DEV_HEATMAP = str(max(config['calibration']['max_shift'], config['alignment']['max_shift']))
else:
    MAX_VAL_DEV_HEATMAP = config['alignment']['max_shift']

if config['matrix_removal']['matrix_mzs']:
    ruleorder: get_matrix_img_list > single_sample_segmentation
else:
    ruleorder: single_sample_segmentation > get_matrix_img_list
if config['matrix_removal']['clustering']:
    ruleorder: single_sample_segmentation > get_matrix_img_list
if config['alignment']['mode'] == 'all':
    ruleorder: get_reference_spectrum_all > get_reference_spectrum_chunked
else:
    ruleorder: get_reference_spectrum_chunked > get_reference_spectrum_all

CHUNKED = config["alignment"]["chunked"]
MEM_PER_WORKER_GB = CHUNKED["memory_per_worker_gb"]
MEM_OVERHEAD_GB = CHUNKED["memory_overhead_gb"]
CHUNKED_WORKERS = min(CHUNKED["cores"], max(1, int((CHUNKED["memory_gb"] - CHUNKED["memory_overhead_gb"]) / CHUNKED["memory_per_worker_gb"])))

# Custom function to calculate resources based on file size
def file_size_resources(wildcards, input_file):
    # Get the file size in bytes
    file_size = os.path.getsize(input_file)

    # Convert file size to MB
    file_size_mb = file_size / (1024 * 1024)

    # Define the resources based on file size
    mem_mb_needed = file_size_mb * 10

    return {"mem_mb": mem_mb_needed}


def get_pipeline_paths(out_dir, files, mass_list):
    snr = config['peak_picking']['snr']
    perc = config['alignment']['pixel_percentage']
    paths = {}

    # Stage 0: base peakpicking
    base = f"{out_dir}/peakpicking_{snr}snr"
    paths['base'] = base

    # Stage 1: calibration
    if config['general']['calibration']:
        base_cal = f"{base}/{config['calibration']['mode']}_{config['calibration']['min_locks']}locks_{config['calibration']['min_intensity']}intensity_{config['calibration']['max_shift']}shift_calibration"
    else:
        base_cal = base
    paths['calibration'] = base_cal

    # Stage 2: alignment
    base_align = f"{base_cal}/alignment_{perc}pxperc"
    paths['alignment'] = base_align

    # Stage 3: matrix removal
    if config['general']['matrix_removal']:
        base_matrix = f"{base_align}/matrix_removal"
    else:
        base_matrix = base_align
    paths['matrix_removal'] = base_matrix

    # Stage 4: peak filtering
    if config['general']['peak_filtering']:
        base_filtered = f"{base_matrix}/{config['peak_filtering']['thr']}sc_filtered"
    else:
        base_filtered = base_matrix
    paths['peak_filtering'] = base_filtered

    # Stage 5: intranorm
    if config['general']['norm']:
        # intranorm
        base_intranorm = f"{base_filtered}/intranorm_{config['intranorm']['method']}"
        # inter-norm
        base_internorm = f"{base_intranorm}/internorm_{config['internorm']['method']}"
    else:
        base_intranorm = base_filtered
        base_internorm = base_filtered
    paths['intranorm'] = base_intranorm
    paths['internorm'] = base_internorm
    paths['median_spectrum'] = f"{base_intranorm}/median_spectrum.npy"

    # Stage 6: outlier removal
    if config['general']['outlier_removal']:
        base_outlier = f"{base_internorm}/outlier_removal"
    else:
        base_outlier = base_internorm
    paths['outlier_removal'] = base_outlier

    # Stage 7: deisotoping
    if config['general']['deisotoping']:
        base_deiso = f"{base_outlier}/deisotoped"
    else:
        base_deiso = base_outlier
    paths['deisotoped'] = base_deiso
    paths['deiso_mz'] = f"{base_deiso}/deiso_mz.npy"

    # Stage 8: summarized CSV
    base_summarized = f"{base_deiso}/summarized"
    paths['summarized'] = base_summarized
    paths['summarized_csv'] = f"{base_summarized}/summarized.csv"

    # Stage 9: imzML and ome.tif
    paths['imzml'] = expand(f"{base_deiso}/{{fl}}.imzML", fl=files)
    paths['ometif'] = expand(f"{base_deiso}/{{fl}}.ome.tif", fl=files)

    # Stage 10: annotation
    paths['annotation_csv'] = f"{base_summarized}/annotation.csv"

    # QC deviation after calibration
    paths['qc_calibration'] = f"{base_cal}/quality_control"
    paths['boxplots_calibration'] = expand(
        f"{base_cal}/quality_control/boxplots/mass_{{mass}}_combined.svg", mass=mass_list
    )

    # QC heatmaps after peak picking
    paths['max_intensity_heatmap'] = expand(
            f"{base}/quality_control/{{fl}}_max_intensity.png", fl=files
        )
    paths['no_peaks_heatmap'] = expand(
        f"{base}/quality_control/{{fl}}_peaks.png",fl=files
    )
    paths['tic_heatmap'] = expand(
        f"{base}/quality_control/{{fl}}_tic.png",fl=files
    )

    # single-sample segmentation for matrix removal
    if not config['matrix_removal']['matrix_mzs']:
        seg_path = f"{base_align}/{config['matrix_removal']['dim_reduction']}"
        if config['matrix_removal']['dim_reduction'] == 'umap':
            seg_path += (f"{config['matrix_removal']['umap_params']['n_neighbors']}neighb_"
                         f"{config['matrix_removal']['cluster_algorithm']}")
        if config['matrix_removal']['cluster_algorithm'] == 'hdbscan':
            seg_path += (f"_{config['matrix_removal']['hdbscan_params']['min_samples']}ms_"
                         f"{config['matrix_removal']['hdbscan_params']['min_cluster_size']}mcs")
    else:
        seg_path = base_align
    paths['segmentation_single_sample'] = seg_path

    # multi-sample segmentation for outlier detection
    paths['segmentation_multi_sample'] = (
        f"{base_internorm}/umap_"
        f"{config['outlier_detection']['umap_params']['n_neighbors']}neighb_"
        f"hdbscan_"
        f"{config['outlier_detection']['hdbscan_params']['min_cluster_size']}mcs_"
        f"{config['outlier_detection']['hdbscan_params']['min_samples']}ms"
    )

    return paths

def get_input(out_dir, files, mass_list, sdf_file, input_list=[]):
    paths = get_pipeline_paths(out_dir, files, mass_list)
    # QC heatmaps
    input_list.append(paths['max_intensity_heatmap'])
    input_list.append(paths['no_peaks_heatmap'])
    input_list.append(paths['tic_heatmap'])
    # QC deviation
    if mass_list and config['general']['calibration']:
        input_list.append(paths['boxplots_calibration'])
    # median spectrum for MFC inter-normalisation
    if config['general']['norm'] and len(files) > 1 and config['internorm']['method'] == 'mfc':
        input_list.append(paths['median_spectrum'])
    # deisotoped m/z vector
    if config['general']['deisotoping']:
        input_list.append(paths['deiso_mz'])
    # summarized CSV
    input_list.append(paths['summarized_csv'])
    # annotation
    if sdf_file:
        input_list.append(paths['annotation_csv'])
    # pre-processed imzML
    input_list.append(paths['imzml'])
    # ome.tif with ion images of peaks
    input_list.append(paths['ometif'])

    return input_list


if config['internorm']['method'] == 'mfc':
    ruleorder: internorm_mfc > internorm
else:
    ruleorder: internorm > internorm_mfc


rule all:
    input: get_input(OUT_DIR, FILES, MASS_LIST, SDF_FILE)
    #input: expand(OUT_DIR + '/peakpicking_' + str(config['peak_picking']['snr']) + 'snr/{fl}.imzML', fl=FILES)
    #input: expand(OUT_DIR + '/peakpicking_' + str(config['peak_picking']['snr']) + 'snr/alignment_' + str(config['alignment']['pixel_percentage']) + 'pxperc/{fl}.imzML', fl=FILES)

rule peak_picking:
    input: INPUT_DIR + '/{fl}.' + EXT
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.peak_picking.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/peak_picking/peak_picking.py {input:q} -snr {config[peak_picking][snr]} \
            -window_size {config[peak_picking][window]} -order {config[peak_picking][order]} -smooth {config[peak_picking][smooth]} \
            -out_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + ' -mass_list ' + QC_MASS_LIST_STR

rule qc_heatmaps:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/{fl}.imzML'
    output: max_intensity_heatmap=get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/quality_control/{fl}_max_intensity.png',
            no_peaks_heatmap=get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/quality_control/{fl}_peaks.png',
            tic_heatmap=get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/quality_control/{fl}_tic.png'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.qc_heatmaps.benchmark.txt",BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/qc/msi_heatmaps.py {input} -result_dir ' +
            get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/quality_control'

rule calibration:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['base'] + '/{fl}.imzML'
    output:
        imzml=get_pipeline_paths(OUT_DIR,FILES,MASS_LIST)['calibration'] + '/{fl}.imzML',
        deviation=expand(get_pipeline_paths(OUT_DIR,FILES,MASS_LIST)['qc_calibration'] + '/{fl}_{mass}_deviation_after_calib.npy', fl="{fl}", mass=MASS_LIST)
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.calibration.benchmark.txt",BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/alignment/alignment.py {input} -calibrate 1 -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['calibration'] +
           ' -mass_list {config[general][mass_list]} -max_shift {config[calibration][max_shift]} -unit {config[calibration][unit]} -min_locks {config[calibration][min_locks]} -method {config[calibration][mode]} '
           '-min_intensity {config[calibration][min_intensity]} -window_size {config[calibration][window_size]}'

rule deviation_to_mass_comparison:
    input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['qc_calibration'] + '/{fl}_{mass}_deviation_after_calib.npy',fl=FILES,mass=MASS_LIST)
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['boxplots_calibration']
