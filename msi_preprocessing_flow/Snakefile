              '-num_px_perc {config[alignment][num_pixel_percentage]} -mass_list {config[general][mass_list]} '
              '-unit {config[alignment][unit]} -mode {config[alignment][mode]}'

rule get_reference_spectrum_chunked:
   input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['calibration'] + '/{fl}.imzML', fl=FILES)
   output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/cmz.npy'
   #benchmark: repeat(BENCHMARK_PATH + "/get_reference_spectrum.benchmark.txt", BM_REPEAT)
   threads: CHUNKED_WORKERS
   resources: mem_mb=CHUNKED["memory_gb"] * 1024
   shell: 'python ' + SCRIPT_PATH + '/alignment/get_reference_spectrum.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['calibration'] + ' -result_dir '
            + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment']
            + ' -mz_res {config[alignment][mz_resolution]} -px_perc {config[alignment][pixel_percentage]} '
              '-num_px_perc {config[alignment][num_pixel_percentage]} -mass_list {config[general][mass_list]} '
              '-unit {config[alignment][unit]} -mode {config[alignment][mode]} -pixel_chunk_size {config[alignment][chunked][pixel_chunk_size]} '
              '-mz_min_da {config[alignment][chunked][mz_min]} -mz_max_da {config[alignment][chunked][mz_max]} -n_jobs {threads}'

rule alignment:
    input: file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['calibration'] + '/{fl}.imzML',
           reference = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/cmz.npy'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.alignment.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/alignment/alignment.py {input.file} -refmz {input.reference} -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + ' -mass_list {config[general][mass_list]} -max_shift {config[alignment][max_shift]} -unit {config[alignment][unit]}'

rule single_sample_segmentation:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_single_sample'] + '/binary_imgs/{fl}_matrix_cluster.tif'
    resources:
        mem_mb=lambda wildcards: file_size_resources(wildcards,input_file=get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment']+"/{}.ibd".format(wildcards.fl))["mem_mb"]
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.single_sample_segmentation.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SEGMENTATION_SCRIPT_PATH + '/single_sample_segmentation.py {input:q} \
            -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_single_sample'] + ' -method {config[matrix_removal][dim_reduction]} -n_components {config[matrix_removal][n_components]}'
            ' -metric {config[matrix_removal][umap_params][metric]} -n_neighbors {config[matrix_removal][umap_params][n_neighbors]}'
            ' -min_dist {config[matrix_removal][umap_params][min_dist]} -n_clusters {config[matrix_removal][kmeans_params][n_clusters]}'
            ' -min_cluster_size {config[matrix_removal][hdbscan_params][min_cluster_size]} -min_samples {config[matrix_removal][hdbscan_params][min_samples]}'
            ' -matrix_cluster True -cluster {config[matrix_removal][cluster_algorithm]}'

rule get_matrix_img_list:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_single_sample'] + '/binary_imgs/{fl}_matrix_cluster.tif'
    shell: 'python ' + SCRIPT_PATH + '/matrix_removal/get_matrix_pixels_from_mz_list.py {input} '
            '{config[matrix_removal][matrix_mzs]} -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_single_sample'] + '/binary_imgs '
            '-threshold {config[matrix_removal][thr_method]}'

rule get_matrix_pixels:
    input: imzML_file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/{fl}.imzML',
            matrix_img = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_single_sample'] + '/binary_imgs/{fl}_matrix_cluster.tif'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}_extended_matrix_image.tif'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.get_matrix_pixels.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/matrix_removal/get_matrix_pixels_from_segmentation.py {input.imzML_file} '
            + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_single_sample'] + '/binary_imgs/ -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal']
            + ' -matrix_corr_thr {config[matrix_removal][matrix_corr_thr]} -pixel_perc_thr {config[matrix_removal][pixel_perc_thr]}'

rule matrix_removal:
    input: imzML_file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/{fl}.imzML',
            extended_matrix_img = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}_extended_matrix_image.tif'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.matrix_removal.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/matrix_removal/matrix_removal.py {input.imzML_file:q} {input.extended_matrix_img:q} '
            '-proc_matrix_img {config[matrix_removal][matrix_postproc]} -pixel_removal {config[matrix_removal][pixel_removal]}'
            ' -matrix_subtraction {config[matrix_removal][matrix_subtraction]}'
            ' -matrix_peaks_removal {config[matrix_removal][matrix_peak_removal]}'
            ' -num_matrix_peaks {config[matrix_removal][num_matrix_peaks]}'

rule calc_spatial_coherence:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}_sc.csv'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.calc_spatial_coherence.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/peak_filtering/spatial_coherence.py {input:q} -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal']

rule sum_spatial_coherence:
    input: sc_files = expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}_sc.csv', fl=FILES),
           imzML_files = expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}.imzML', fl=FILES)
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/peaks_above_' + str(config['peak_filtering']['thr']) + 'sc.npy'
    #benchmark: repeat(BENCHMARK_PATH + "/sum_spatial_coherence.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/peak_filtering/get_mzs_above_spatial_coherence_thr.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + ' '
            + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + ' ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + ' -thr ' + str(config['peak_filtering']['thr']) + ' -sum ' + str(config['peak_filtering']['sum'])

rule filter_spatial_coherence:
    input: imzML_file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/{fl}.imzML',
           sc_thr_file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['matrix_removal'] + '/peaks_above_' + str(config['peak_filtering']['thr']) + 'sc.npy'
