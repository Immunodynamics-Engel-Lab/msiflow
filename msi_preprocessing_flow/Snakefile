    shell: 'python ' + SCRIPT_PATH + '/peak_filtering/filter_spatial_coherence.py {input.imzML_file} {config[peak_filtering][thr]} {input.sc_thr_file} -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['peak_filtering']

rule intranorm:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['peak_filtering'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['intranorm'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.intranorm.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/intranorm/intranorm.py {input:q} -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['intranorm'] + ' -method {config[intranorm][method]}'

rule median_spectrum:
    input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['intranorm'] + '/{fl}.imzML', fl=FILES)
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['median_spectrum']
    #benchmark: repeat(BENCHMARK_PATH + "/median_spectrum.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/internorm/get_median_overall_spectrum.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['intranorm'] + ' {output:q}'

rule internorm_mfc:
    input: file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['intranorm'] + '/{fl}.imzML',
            reference = rules.median_spectrum.output
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.internorm.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/internorm/internorm.py {input.file:q} -result_dir ' \
           + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + ' -method {config[internorm][method]} -reference {input.reference:q}'

rule internorm:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['intranorm'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.internorm.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/internorm/internorm.py {input.file:q} -result_dir ' \
           + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + '\' -method {config[internorm][method]}'

rule multi_sample_segmentation:
    input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + '/{fl}.imzML', fl=FILES)
    #output: seg_imgs = get_io_path_multi_sample_segmentation()[1]  + '/{fl}.png',
    #        umap_data = get_io_path_multi_sample_segmentation()[1] + '/umap_data.csv'
    output: umap_data = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_multi_sample'] + '/umap_data.csv'
    #benchmark: repeat(BENCHMARK_PATH + "/multi_sample_segmentation.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SEGMENTATION_SCRIPT_PATH + '/multi_sample_segmentation.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm']
            + ' -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['segmentation_multi_sample']
            + ' -n_neighbors {config[outlier_detection][umap_params][n_neighbors]}'
            ' -min_cluster_size {config[outlier_detection][hdbscan_params][min_cluster_size]}'
            ' -min_samples {config[outlier_detection][hdbscan_params][min_samples]}'

rule outlier_detection:
    input: umap_data = rules.multi_sample_segmentation.output.umap_data,
            imzML_files = expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + '/{fl}.imzML', fl=FILES)
    output: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['outlier_removal'] + '/{fl}.imzML', fl=FILES)
    #benchmark: repeat(BENCHMARK_PATH + "/outlier_detection.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/outlier_detection/umap_outlier_detection.py {input.umap_data} '
            + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['internorm'] + ' -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['outlier_removal']
            + ' -cluster_thr {config[outlier_detection][cluster_thr]} -sample_thr {config[outlier_detection][sample_thr]}'
              ' -remove_ssc {config[outlier_detection][remove_ssc]}'

rule get_deisotoped_mz:
    input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['outlier_removal'] + '/{fl}.imzML', fl=FILES)
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deiso_mz']
    #benchmark: repeat(BENCHMARK_PATH + "/get_deisotoped_mz.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/deisotoping/get_deisotoped_mz.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['outlier_removal'] +
            ' -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped'] +
            ' -tolerance {config[deisotoping][tolerance]} -min_isotopes {config[deisotoping][min_isotopes]} \
            -max_isotopes {config[deisotoping][max_isotopes]} -openMS {config[deisotoping][openMS]} -unit {config[deisotoping][unit]} \
            -corr_thr {config[deisotoping][corr_thr]} -intensity_thr {config[deisotoping][intensity_thr]}'

rule deisotoping:
    input: reference = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deiso_mz'],
            file = get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['outlier_removal'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped'] + '/{fl}.imzML'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.deisotoping.benchmark.txt", BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/deisotoping/deisotope.py {input.file:q} {input.reference:q} \
            -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped']

rule summarize:
    input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped'] + '/{fl}.imzML', fl=FILES)
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['summarized_csv']
    #benchmark: repeat(BENCHMARK_PATH + "/summarize.benchmark.txt",BM_REPEAT)
    shell: 'python ' + ANALYSIS_SCRIPT_PATH + '/get_summarized_spectra.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped']
            + ' -result_dir ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped'] + '/summarized -qc True'

rule annotation:
    input: summarized=get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['summarized_csv'], sdf=join(DATA_PATH, 'structures.sdf')
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['annotation_csv']
    #benchmark: repeat(BENCHMARK_PATH + "/annotation.benchmark.txt",BM_REPEAT)
    shell: 'python ' + SCRIPT_PATH + '/annotation/mass_matching.py {input.sdf} {input.summarized} '
            + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['summarized']
            + ' -unit {config[annotation][unit]} -tol {config[annotation][tolerance]} -even_chains_only {config[annotation][even_chains_only]} '
              '-lipid_classes {config[annotation][lipid_classes]} -adducts {config[annotation][adducts]}'

rule ion_image_stack:
    input: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped'] + '/{fl}.imzML'
    output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['deisotoped'] + '/{fl}.ome.tif'
    #benchmark: repeat(BENCHMARK_PATH + "/{fl}.ion_image_stack.benchmark.txt",BM_REPEAT)
    shell: 'python ' + VIS_SCRIPT_PATH + '/generate_mz_tif_stack.py {input} {output}'

