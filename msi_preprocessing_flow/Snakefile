rule get_reference_spectrum_all:
   input: expand(get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['calibration'] + '/{fl}.imzML', fl=FILES)
   output: get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment'] + '/cmz.npy'
   #benchmark: repeat(BENCHMARK_PATH + "/get_reference_spectrum.benchmark.txt", BM_REPEAT)
   shell: 'python ' + SCRIPT_PATH + '/alignment/get_reference_spectrum.py ' + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['calibration'] + ' -result_dir '
            + get_pipeline_paths(OUT_DIR, FILES, MASS_LIST)['alignment']
